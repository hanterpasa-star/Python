# Получите токен у официального @BotFather. Не отправляйте его другим людям.
BOT_TOKEN=

# Ваш числовой Telegram ID. Свой ID покажет команда /id даже без доступа.
# Владелец выдаёт и отзывает доступ сотрудников прямо в боте.
OWNER_ID=

# group — уведомления в рабочую группу; staff — в личные сообщения сотрудникам.
NOTIFICATION_MODE=group

# Необязательно: ID рабочей группы. Проще добавить бота в группу и вызвать /notify_here.
NOTIFICATION_CHAT_ID=

# Путь относительно папки проекта. База сохраняется после перезапуска.
DATABASE_PATH=data/shop.sqlite3
